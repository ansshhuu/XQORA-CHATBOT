GROQ_API_KEY=
OPENROUTER_API_KEY=
RESEND_API_KEY=
TEAM_EMAIL=

# Required, no default. A Postgres connection string in production/Vercel;
# sqlite:///./xqora_chatbot.db is fine for local dev.
DATABASE_URL=

# Full contents of the Google service-account JSON key, as a single-line
# string (e.g. `GOOGLE_CREDS_JSON=$(cat credentials/google_sheets.json | jq -c .)`
# locally, or pasted as-is into Vercel's env var value). No credentials file
# is read anymore - see app/services/sheets_service.py.
GOOGLE_CREDS_JSON=
GOOGLE_SHEET_ID=
CORS_ORIGINS=https://xqora.com,https://www.xqora.com

# Only set to "true" in local/CI test runs (see TESTING.md). NEVER set this
# in production or in Vercel's env vars - it stubs out real Groq/OpenRouter/
# Resend calls.
TEST_MODE=

# Optional - all have working defaults in app/core/config.py /
# app/services/ai_service.py, only set these to override.

# Optional, default: qwen/qwen3.6-27b
GROQ_MODEL=

# Optional, default: openai/gpt-oss-20b:free
OPENROUTER_MODEL=

# Optional, default: 10
RATE_LIMIT_PER_MINUTE=

# Optional, default: 1000
MAX_MESSAGE_LENGTH=

# Optional, default: 3600
SESSION_TTL_SECONDS=


